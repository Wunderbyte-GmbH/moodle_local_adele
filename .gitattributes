# Enforce LF line endings for all text files.
* text=auto eol=lf

# Binary files — no conversion.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.min.js binary
*.min.css binary

# Exclude developer artefacts from release archives.
.github/          export-ignore
# Browser tests: node dependencies, a lockfile and a Playwright config
# are development tooling, not part of a Moodle plugin release. CI is
# unaffected — actions/checkout clones the repository, it does not use
# git archive.
tests/playwright/ export-ignore
# Load-test plans and fixtures: manually triggered tooling, not part of a
# release either.
tests/load/       export-ignore
# Vue3 sources: the plugin ships the compiled bundle in amd/build/, which
# is what Moodle loads at runtime. The source tree, its lockfile and its
# Jest setup are build tooling. Verified: no PHP or Mustache file
# references vue3/ at runtime.
vue3/             export-ignore
docs/             export-ignore
tools/            export-ignore
Makefile          export-ignore
CHANGELOG.md      export-ignore
.gitattributes    export-ignore
.gitignore        export-ignore
.phpcsignore      export-ignore
.phpcs.xml        export-ignore

# Test fixtures: Moodle course backups are archives, never text.
*.mbz binary
